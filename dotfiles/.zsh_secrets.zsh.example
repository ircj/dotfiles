# Voorbeeld van ~/.zsh_secrets.zsh
# --------------------------------
# Kopieer dit bestand naar ~/.zsh_secrets.zsh en vul je echte waarden in.
# Dit bestand (.example) mag WEL in git; ~/.zsh_secrets.zsh NOOIT (staat in .gitignore).
#
#   cp ~/dotfiles/.zsh_secrets.zsh.example ~/.zsh_secrets.zsh
#   chmod 600 ~/.zsh_secrets.zsh
#   $EDITOR ~/.zsh_secrets.zsh
#
# .zshrc sourcet dit bestand automatisch als het bestaat.

# LiteLLM gateway API-key (provider "litellm" in opencode.json).
export LITELLM_API_KEY="<jouw-litellm-key>"

# Obsidian Local REST API bearer token (rauwe API-key uit de plugin-instellingen).
export OBSIDIAN_MCP_BEARER_TOKEN="<jouw-obsidian-bearer-token>"
